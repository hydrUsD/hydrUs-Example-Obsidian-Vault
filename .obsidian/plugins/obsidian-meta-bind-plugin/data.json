{
  "devMode": false,
  "ignoreCodeBlockRestrictions": false,
  "preferredDateFormat": "YYYY-MM-DD",
  "firstWeekday": {
    "index": 1,
    "name": "Monday",
    "shortName": "Mo"
  },
  "syncInterval": 200,
  "enableJs": true,
  "viewFieldDisplayNullAsEmpty": false,
  "enableSyntaxHighlighting": true,
  "enableEditorRightClickMenu": true,
  "inputFieldTemplates": [
    {
      "name": "taskDoneBy",
      "declaration": "INPUT[inlineSelect(\n    option(Fabi),\n    option(Paul)\n):taskDoneBy]"
    },
    {
      "name": "obsidianUIMode",
      "declaration": "INPUT[toggle(\n    showcase,\n    onValue(preview),\n    offValue(source),\n    defaultValue(source)\n):obsidianUIMode]"
    }
  ],
  "buttonTemplates": [
    {
      "label": "5-Minute Morning Kickstart",
      "icon": "",
      "style": "primary",
      "class": "",
      "cssStyle": "",
      "backgroundImage": "",
      "tooltip": "create a new 5-Minute Kickstart Note",
      "id": "5mkickstart",
      "hidden": false,
      "actions": [
        {
          "type": "regexpReplaceInNote",
          "regexp": "(`BUTTON\\[5mkickstart\\]`)",
          "replacement": "**[[<%tp.date.now(\"YYYYMMDD\") + \" - 5-Minute Kickstart\"%>]]**",
          "regexpFlags": "g"
        },
        {
          "type": "command",
          "command": "templater-obsidian:replace-in-file-templater"
        },
        {
          "type": "runTemplaterFile",
          "templateFile": "99 - Meta/00 - Templates/5mkickstart.md"
        }
      ]
    },
